# Legacy Jekyll paths from the previous site generation.
# Targets are checked against the current page set — the maintenance flow was
# called "schedule" then, and the two how-tos have been folded into the docs.
/pages/schedule-maintenance      /maintenance.html         301
/pages/request-dispatch          /dispatch.html            301
/pages/howtos                    /docs/                    301
/pages/howtos/controller-guide   /docs/leg.html#controller 301
/pages/howtos/leg-replacement    /docs/operating.html      301
/pages/*                         /                         301

# Stable short links safe to print on equipment labels and QR codes.
# /schedule predates the rename and stays pointed at the flag flow, because
# labels carrying it are already out in the field.
#
# /dispatch and /maintenance are deliberately NOT listed here even though
# they are stable short links too: html_handling defaults to
# auto-trailing-slash, which already 307s dispatch.html/maintenance.html to
# exactly those extensionless paths. A 301 rule redirecting the same path
# back to the .html file creates a redirect loop that browsers report as a
# bare connection failure, not an error page — do not re-add them.
/maintence                       /maintenance.html         301
/schedule                        /maintenance.html         301
/faults                          /docs/faults.html         301
/firmware                        /firmware/index.html      301
/help                            /docs/                    301
