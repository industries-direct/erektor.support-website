{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the live Worker service, or a deploy creates a second service
  // and binds the custom domain to that one instead, orphaning this one.
  // .github/workflows/deploy.yml asserts this value before wrangler runs.
  "name": "support-erektor-return-systems-website",
  "main": "src/index.js",
  "compatibility_date": "2026-08-14",
  "routes": [
    { "pattern": "erektor.support", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    // The site is committed as plain HTML at the repo root; .assetsignore
    // keeps the Worker source, the page assembler and repo metadata out of
    // what gets uploaded.
    "directory": ".",
    "binding": "ASSETS",
    // Unmatched paths get the styled 404 rather than a bare edge error.
    "not_found_handling": "404-page",
    // ...which is exactly why the intake endpoint has to jump the queue:
    // without this it would be answered with 404.html instead of reaching
    // the Worker.
    //
    // /internal/* is here for a sharper reason than reachability: those pages
    // ARE static assets, and without this line the asset layer would serve the
    // leg registry straight off the CDN to anyone who guessed the path. This
    // entry is what puts src/auth.js in front of them. Removing it publishes
    // the fleet, silently and with no error anywhere.
    //
    // The docs, firmware and the two request forms are here for the same
    // reason: they are customer-only now (src/portal.js), and the gate only
    // runs if the Worker does.
    "run_worker_first": [
      "/api/*", "/internal/*", "/account", "/account/*",
      "/docs", "/docs/*", "/firmware", "/firmware/*",
      "/dispatch", "/dispatch.html", "/maintenance", "/maintenance.html"
    ]
  },

  // The internal leg registry (src/registry.js). Create it with
  //   wrangler d1 create erektor-registry
  //   wrangler d1 migrations apply erektor-registry --remote
  // then set the id it prints below. Until it is bound,
  // /api/registry/* answers 503 and the public intake simply skips
  // reconciliation - the portal itself is unaffected.
  //
  // The section also needs two secrets, which are NOT config and never live
  // in this file:
  //   wrangler secret put REGISTRY_SECRET   # HMAC key for session cookies
  //   wrangler secret put REGISTRY_ACCESS   # JSON array of operators
  //
  // Account-portal requests are emailed to the service desk. Cloudflare only
  // delivers to verified Email Routing destinations, and this binding is
  // locked to this one.
  "send_email": [
    { "name": "NOTIFY", "destination_address": "erektobot@erektor.systems" }
  ],

  "d1_databases": [
    {
      "binding": "REGISTRY",
      "database_name": "erektor-registry",
      "database_id": "691397ac-8ca2-4c24-a7c1-7851f568700f",
      "migrations_dir": "migrations"
    },
    {
      // Customer accounts, shared with erektor-return.systems, which owns
      // the schema (its migrations/ directory). src/portal.js reads it.
      "binding": "ACCOUNTS",
      "database_name": "ers-accounts",
      "database_id": "5df46a8a-9445-40f8-b351-c6c4f47062ae"
    }
  ]
}
